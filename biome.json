{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"packages/**",
			"scripts/**",
			"lint/**",
			"*.json",
			"!**/*.vue",
			"!**/test/fixtures",
			"!packages/db/migrations"
		]
	},
	"formatter": {
		"lineWidth": 100
	},
	"linter": {
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noPrivateImports": "error"
			},
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"@ultrasonics/db/auth-store": "The auth store is for the session middleware and boot only (ADR-0009 §4). Use storeFor(accountId).",
							"@ultrasonics/db/system": "The system module is for boot, the scheduler and the webhook route only (ADR-0028). Use storeFor(accountId)."
						}
					}
				}
			},
			"suspicious": {
				"noImportCycles": {
					"level": "error",
					"options": { "ignoreTypes": true }
				}
			}
		}
	},
	"overrides": [
		{
			"includes": ["packages/plugins/**"],
			"plugins": ["./lint/no-unkillable-block.grit"]
		},
		{
			"includes": ["packages/db/**", "packages/server/src/boot.ts"],
			"linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
		},
		{
			"includes": ["packages/server/src/session-middleware.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@ultrasonics/db/system": "The system module is for boot, the scheduler and the webhook route only (ADR-0028). Use storeFor(accountId)."
								}
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/server/src/scheduler.ts", "packages/server/src/webhook-route.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@ultrasonics/db/auth-store": "The auth store is for the session middleware and boot only (ADR-0009 §4). Use storeFor(accountId)."
								}
							}
						}
					}
				}
			}
		}
	]
}
