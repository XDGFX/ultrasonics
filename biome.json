{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"packages/**",
			"scripts/**",
			"lint/**",
			"*.json",
			"!**/*.vue",
			"!**/test/fixtures",
			"!packages/db/migrations"
		]
	},
	"formatter": {
		"lineWidth": 100
	},
	"linter": {
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noPrivateImports": "error"
			},
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"@ultrasonics/db/auth-store": "The auth store is for the session middleware and boot only (ADR-0009 §4). Use storeFor(accountId).",
							"@ultrasonics/db/system": "The system module is for boot, the scheduler and the webhook route only (ADR-0028). Use storeFor(accountId)."
						}
					}
				}
			},
			"suspicious": {
				"noImportCycles": {
					"level": "error",
					"options": { "ignoreTypes": true }
				}
			}
		}
	},
	"overrides": [
		{
			"includes": ["packages/plugins/**"],
			"plugins": ["./lint/no-worker-unsafe-code.grit"]
		},
		{
			"includes": [
				"packages/core/src/run-events.ts",
				"packages/core/src/run-event.ts",
				"packages/core/src/journal.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"**",
											"!zod",
											"!@ultrasonics/plugin-sdk",
											"!./run-event.ts",
											"!./journal.ts"
										],
										"message": "The run-events subpath is imported by the UI: it may reach only Zod, the SDK and its own files, never the runner."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/server/src/api.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@ultrasonics/db": {
										"message": "@ultrasonics/server/api may import only the db's schema exports, never what opens the database.",
										"allowImportNames": [
											"Applet",
											"AppletChanges",
											"AppletDefinition",
											"FinishedRunStatus",
											"JsonObject",
											"JsonValue",
											"NewApplet",
											"Run",
											"RunJournal",
											"RunStatus",
											"RunSummary",
											"RunTrigger",
											"Schedule",
											"Slot"
										]
									}
								},
								"patterns": [
									{
										"group": [
											"**",
											"!zod",
											"!@ultrasonics/plugin-sdk",
											"!@ultrasonics/db",
											"!@ultrasonics/core/run-events"
										],
										"message": "@ultrasonics/server/api is imported by the UI: it may reach only Zod, the SDK, the db's schema exports and @ultrasonics/core/run-events."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/db/**", "packages/server/src/boot.ts"],
			"linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
		},
		{
			"includes": [
				"packages/server/src/session-middleware.ts",
				"packages/server/src/operator-settings.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@ultrasonics/db/system": "The system module is for boot, the scheduler and the webhook route only (ADR-0028). Use storeFor(accountId)."
								}
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/server/src/scheduler.ts", "packages/server/src/webhook-route.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@ultrasonics/db/auth-store": "The auth store is for the session middleware and boot only (ADR-0009 §4). Use storeFor(accountId)."
								}
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/web/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@ultrasonics/core": "The UI reaches core only through @ultrasonics/core/run-events, which holds no runner code.",
									"@ultrasonics/server": "The UI reaches the server only through @ultrasonics/server/api, which holds only its schemas."
								},
								"patterns": [
									{
										"group": ["@ultrasonics/server/**", "!@ultrasonics/server/api"],
										"message": "The UI reaches the server only through @ultrasonics/server/api, which holds only its schemas."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
