{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun test *)",
      "Bash(bun run test *)",
      "Bash(bun run build *)",
      "Bash(bun run check *)",
      "Bash(bun run check:ci *)",
      "Bash(bun run lint:check *)",
      "Bash(bun run format:check *)",
      "Bash(bun run type-check *)",
      "Bash(bun run cycle-check *)",
      "Bash(bun install *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git worktree *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)"
    ],
    "deny": [
      "Bash(gh pr comment *)",
      "Bash(gh pr * comment *)",
      "Bash(gh * pr comment *)",
      "Bash(gh * pr * comment *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr * merge *)",
      "Bash(gh * pr merge *)",
      "Bash(gh * pr * merge *)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * push * -f*)",
      "Bash(git push * +*)",
      "Bash(git -C * push * +*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git -C * push --mirror*)",
      "Bash(git -C * push * --mirror*)",
      "Bash(git push --all*)",
      "Bash(git push * --all*)",
      "Bash(git -C * push --all*)",
      "Bash(git -C * push * --all*)",
      "Bash(git push *master*)",
      "Bash(git -C * push *master*)"
    ]
  }
}
